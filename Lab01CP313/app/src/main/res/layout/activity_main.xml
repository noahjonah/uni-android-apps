<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <TextView
        android:id="@+id/instructionMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:layout_marginStart="30dp"
        android:layout_marginEnd="30dp"
        android:text="@string/App_instructions"
        android:textSize="20sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:ignore="VisualLintBounds,TextSizeCheck" />

    <EditText
        android:id="@+id/firstNameEntry"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:autofillHints="Name"
        android:background="@drawable/inputs_background"
        android:ems="10"
        android:hint="@string/first_name_hint"
        android:inputType="text"
        android:minHeight="48dp"
        android:paddingStart="@dimen/_10dp"
        android:paddingEnd="@dimen/_10dp"
        android:textColorHint="#795548"
        app:layout_constraintStart_toStartOf="@+id/instructionMessage"
        app:layout_constraintTop_toBottomOf="@+id/instructionMessage"
        tools:ignore="RtlSymmetry" />

    <EditText
        android:id="@+id/secondNameEntry"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/inputs_background"
        android:ems="10"
        android:hint="@string/second_name_entry"
        android:inputType="text"
        android:minHeight="48dp"
        android:paddingStart="@dimen/_10dp"
        android:paddingEnd="@dimen/_10dp"
        android:textColorHint="#795548"
        app:layout_constraintStart_toStartOf="@+id/firstNameEntry"
        app:layout_constraintTop_toBottomOf="@+id/firstNameEntry"
        tools:ignore="Autofill" />

    <EditText
        android:id="@+id/surnameEntry"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/inputs_background"
        android:ems="10"
        android:hint="@string/surnameEntry"
        android:inputType="text"
        android:minHeight="48dp"
        android:paddingStart="@dimen/_10dp"
        android:paddingEnd="@dimen/_10dp"
        android:textColorHint="#795548"
        app:layout_constraintStart_toStartOf="@+id/secondNameEntry"
        app:layout_constraintTop_toBottomOf="@+id/secondNameEntry"
        tools:ignore="Autofill" />

    <EditText
        android:id="@+id/emailAddressEntry"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:autofillHints="email"
        android:background="@drawable/inputs_background"
        android:ems="10"
        android:hint="@string/email_address_entry"
        android:inputType="textEmailAddress"
        android:minHeight="48dp"
        android:paddingStart="@dimen/_10dp"
        android:paddingEnd="@dimen/_10dp"
        android:textColorHint="#455A64"
        app:layout_constraintStart_toStartOf="@+id/surnameEntry"
        app:layout_constraintTop_toBottomOf="@+id/surnameEntry" />

    <EditText
        android:id="@+id/dateOfBirthEntry"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/inputs_background"
        android:ems="10"
        android:hint="@string/date_of_birth"
        android:inputType="date"
        android:minHeight="48dp"
        android:paddingStart="@dimen/_10dp"
        android:paddingEnd="@dimen/_10dp"
        android:textColorHint="#795548"
        app:layout_constraintStart_toStartOf="@+id/emailAddressEntry"
        app:layout_constraintTop_toBottomOf="@+id/emailAddressEntry"
        tools:ignore="Autofill" />

    <EditText
        android:id="@+id/phoneNumberEntry"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/inputs_background"
        android:ems="10"
        android:hint="@string/phoneNumber"
        android:inputType="phone"
        android:minHeight="48dp"
        android:paddingStart="@dimen/_10dp"
        android:paddingEnd="@dimen/_10dp"
        android:textColorHint="#795548"
        app:layout_constraintStart_toStartOf="@+id/dateOfBirthEntry"
        app:layout_constraintTop_toBottomOf="@+id/dateOfBirthEntry"
        tools:ignore="Autofill" />

    <EditText
        android:id="@+id/usernameEntry"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/inputs_background"
        android:ems="10"
        android:hint="@string/username"
        android:inputType="text"
        android:minHeight="48dp"
        android:paddingStart="@dimen/_10dp"
        android:paddingEnd="@dimen/_10dp"
        android:textColorHint="#795548"
        app:layout_constraintStart_toStartOf="@+id/phoneNumberEntry"
        app:layout_constraintTop_toBottomOf="@+id/phoneNumberEntry"
        tools:ignore="Autofill" />

    <EditText
        android:id="@+id/passwordEntry"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/inputs_background"
        android:ems="10"
        android:hint="@string/password"
        android:inputType="textPassword"
        android:minHeight="48dp"
        android:paddingStart="@dimen/_10dp"
        android:paddingEnd="@dimen/_10dp"
        android:textColorHint="#795548"
        app:layout_constraintStart_toStartOf="@+id/usernameEntry"
        app:layout_constraintTop_toBottomOf="@+id/usernameEntry"
        tools:ignore="Autofill" />

    <TextView
        android:id="@+id/textView2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:textColor="@color/black"
        android:text="@string/genderInstruction"
        app:layout_constraintStart_toStartOf="@+id/countryEntry"
        app:layout_constraintTop_toBottomOf="@+id/countryEntry" />

    <RadioGroup
        android:id="@+id/radioGroupGender"
        android:layout_width="300dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintStart_toStartOf="@+id/textView2"
        app:layout_constraintTop_toBottomOf="@+id/textView2">

        <RadioButton
            android:id="@+id/radioButtonMale"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minHeight="48dp"
            android:text="@string/radioButtonMale" />

        <RadioButton
            android:id="@+id/radioButtonFemale"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minHeight="48dp"
            android:text="@string/radioButtonFemale" />
    </RadioGroup>

    <EditText
        android:id="@+id/countryEntry"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:autofillHints="country"
        android:background="@drawable/inputs_background"
        android:ems="10"
        android:hint="@string/country_entry"
        android:inputType="text"
        android:minHeight="48dp"
        android:paddingStart="@dimen/_10dp"
        android:paddingEnd="@dimen/_10dp"
        android:textColorHint="#795548"
        app:layout_constraintStart_toStartOf="@+id/passwordEntry"
        app:layout_constraintTop_toBottomOf="@+id/passwordEntry" />

    <Button
        android:id="@+id/submitButton"
        android:layout_width="150dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20dp"
        android:background="@drawable/btn_background"
        android:text="@string/submit_button"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="@+id/radioGroupGender" />


</androidx.constraintlayout.widget.ConstraintLayout>